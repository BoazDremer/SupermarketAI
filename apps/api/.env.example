# HTTP port for the NestJS API (default 4000).
PORT=4000

# PostgreSQL — required for Prisma when you enable real persistence.
# Copy from packages/db/.env.example or set the same value here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supermarket?schema=public"

# Comma-separated browser origins for CORS (Vite default: http://localhost:5173).
CORS_ORIGINS="http://localhost:5173"
