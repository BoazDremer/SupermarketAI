  "rules": [
    {
      "id": "fruits-leaves",
      "summary": "Under level-1 פירות keep exactly two leaves: פירות-טריים and פירות-יבשים."
    },
    {
      "id": "dried-fruit-under-fruits",
      "summary": "Collapse former level-1 group פירות-יבשים into leaf dept/.../פירות/פירות-יבשים; remove its former level-2 children."
    },
    {
      "id": "packed-veg-only-under-vegetables",
      "summary": "ירקות ארוזים must not appear under פירות; only under ירקות."
    },
    {
      "id": "fresh-fruit-once",
      "summary": "פירות-טריים appears only under פירות, not under ירקות."
    },
    {
      "id": "no-general-under-fruits-veg-nuts",
      "summary": "Do not synthesize /general under פירות, ירקות, or פיצוחים groups."
    },
    {
      "id": "nuts-group-rename",
      "summary": "Group dept/.../פיצוחים is named פיצוחים (not פיצוחים ופירות יבשים)."
    },
    {
      "id": "nuts-three-leaves",
      "summary": "Under פיצוחים keep only: פיצוחים-טבעיים, פיצוחים-קלויים, מנצ'ס."
    },
    {
      "id": "remove-roasted-almonds-bulk-group",
      "summary": "Remove level-1 קליית-השקמה-בתפזורת; RL codes move to dept/שימורים-בישול-ואפיה/תבלינים/תבלינים-במשקל."
    },
    {
      "id": "no-dept-general",
      "summary": "Do not keep or synthesize dept/פירות-וירקות/general."
    }
  ],
